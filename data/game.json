  "help": {
    "ui_panel": {
      "title": "Нижняя панель",
      "text": "Слева миникарта, в центре группы и выбранные юниты, справа команды, оружие и камера, справа окно связи для персонажей кампании."
    },
    "ui_minimap": {
      "title": "Миникарта",
      "text": "ЛКМ или перетаскивание — переместить камеру. ПКМ — приказ выбранным юнитам в эту точку. Белая рамка — что видит камера. Тёмное — туман войны."
    },
    "ui_groups": {
      "title": "Группы",
      "text": "Ctrl+1…0 — записать выбранных в группу. 1…0 — выбрать группу, дважды — камера к ней. Alt+номер или кнопка «✕ Расформировать» (Backspace) — убрать группу."
    },
    "ui_selection": {
      "title": "Выбор",
      "text": "Сведения о выбранном юните или заводе. Если выбрано несколько — список юнитов, клик по нему оставляет одного."
    },
    "ui_orders": {
      "title": "Режимы приказов",
      "text": "Марш — ПКМ по контексту (ход, атака, захват). Захват — инженеры идут на узел. Охрана — держать точку или флаг. Флаг F / Снять R — метки для охраны."
    },
    "ui_weapons": {
      "title": "Оружие и режимы",
      "text": "◀ ▶ — основное оружие, − + — сила (I–III). Z — основной режим, X — усиленный (сильнее, долгая перезарядка), C — особый (копит заряд, проценты на кнопке). T — способность."
    },
    "ui_camera": {
      "title": "Камера",
      "text": "WASD/стрелки/край экрана — сдвиг, Q/E — поворот на 90°, колесо или +/− — масштаб, Home или 100% — сброс масштаба.\nПробел — к своим базам и заводам по кругу; если недавно была тревога — сначала к ней.\nEnd — к последнему событию (атака, захват, потеря).\nДвойное нажатие цифры группы — камера к группе.\nBackspace или щелчок по названию выбранного в панели — к выбранным.\nМиникарта: ЛКМ/перетаскивание — камера, ПКМ — приказ выбранным.\nВсе клавиши переназначаются в «Настройки → Управление»."
    },
    "ui_exit": {
      "title": "Выход и выгрузка",
      "text": "«В лобби» и крестик окна спрашивают подтверждение («Точно покинуть матч?», «Выйти из игры?»). Enter — да, Esc — нет.\nПосле подтверждения экран выгрузки показывает реальные этапы: отключение сети, выгрузка техники, снос построек, сохранение настроек."
    },
    "ui_log": {
      "title": "Журнал и запись при падении",
      "text": "Настройки → «Журнал». По умолчанию всё выключено.\nЖурнал: уровни TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL (галочки или «Все уровни»). Файлы game_<дата>_<время>.log в папке logs рядом с exe, хранятся последние 10.\nЗапуск с флагом --log=all, --log=info,error или --log=off (либо переменная NE_LOG) перекрывает настройку.\n«Запись при падении» — отдельная галочка: каждая строка сразу пишется на диск, сохраняются ошибки движка и скриптов; если игра закрылась аварийно, при следующем запуске журнал прошлой сессии сохраняется как crash_<время>.log."
    },
    "ui_story": {
      "title": "Окно связи",
      "text": "Здесь будут говорить персонажи кампании."
    },
    "ui_resources": {
      "title": "Ресурсы",
      "text": "Металл, чипы и энергия — общий склад. Доход дают штаб и захваченные добыча, чипы, станция."
    },
    "ui_difficulty": {
      "title": "Сложность ИИ",
      "text": "Пять уровней: [b]Новичок[/b], [b]Лёгкий[/b], [b]Средний[/b], [b]Сложный[/b], [b]Эксперт[/b]. Каждому компьютерному слоту в лобби задаётся свой уровень; кнопки справа сверху меняют уровень всех ИИ сразу. Параметры уровней — data/game.json, раздел skirmish.levels."
    },
    "ui_cheats": {
      "title": "Читы (F9)",
      "text": "Опция хоста «Разрешить читы» в лобби (по умолчанию включена в одиночной игре; в сети решает создатель сервера, клиенты видят её). Если выключена, F9 не открывает панель. Бессмертие, мгновенные особые режимы, ресурсы, без тумана, спавн юнитов, зданий и ландшафта: выбрать, «Ставить», ЛКМ по карте, ПКМ/Esc — закончить."
    },
    "ui_settings": {
      "title": "Настройки (Esc / F10)",
      "text": "Графика (пресеты и отдельные опции), экран, интерфейс (размер текста, масштаб, время подсказки F1), звук, управление. Сохраняются в user://settings.cfg."
    },
    "controls": {
      "title": "Управление",
      "text": "ЛКМ — выбрать, рамка ЛКМ — несколько, Shift — добавить, Ctrl+клик — убрать. ПКМ — действие по курсору: ход, атака, захват. Ctrl+ПКМ — огонь по земле. Z/X/C — режим оружия, T — способность, F/R — флаг. F1 над чем угодно — подсказка (клик по ней — статья). Shift+F1 — справочник. Esc — настройки, F9 — читы."
    },
    "cursors": {
      "title": "Курсоры",
      "text": "Стрелка — ничего не выбрано. Зелёные шевроны — ход. Жёлтый флажок — захват. Синий щит — охрана. Красный прицел — атака. Оранжевый прицел с чертой — огонь по земле (Ctrl). Фиолетовый плюс — размещение (читы)."
    },
    "fog": {
      "title": "Туман войны",
      "text": "Неразведанное — тёмное, разведанное вне обзора — полутень. Враги видны только в обзоре своих юнитов и узлов. Отключается в читах."
    },
    "lobby": {
      "title": "Лобби схватки",
      "text": "Перед боем выберите карту (на 2, 4, 6 или 8 игроков). Для каждого слота: [b]Человек[/b] (игрок по сети), [b]Компьютер[/b] (ИИ с уровнем) или [b]Закрыт[/b]. Задайте команду (одинаковый номер — союзники), цвет и стартовую позицию. «Начать бой» запускает схватку. Победа — когда штабы всех враждебных команд разрушены или захвачены."
    },
    "maps": {
      "title": "Карты",
      "text": "Карты лежат в data/maps/*.json и правятся вручную (формат — docs/MAPS.md). Все карты схватки симметричны: у каждого старта одинаковые штаб, добыча и путь до центра. Классика — исходная вытянутая карта 1 на 1."
    },
    "multiplayer": {
      "title": "Игра по сети (LAN)",
      "text": "[b]Создать сервер[/b]: имя игры и порт (по умолчанию 24680). Остальные жмут [b]Найти игру[/b] — сервера локальной сети появляются в списке (имя, карта, игроки, пинг). Если поиск не видит сервер, введите IP:порт вручную. Хост может отдать свободные слоты компьютеру. Брандмауэр Windows: tools\\firewall.ps1 (от администратора). Сервер считает бой сам, клиенты присылают приказы и получают состояние."
    },
    "victory": {
      "title": "Победа и поражение",
      "text": "Сторона выбывает, когда её штаб разрушен или захвачен. Команда побеждает, когда остались только её стороны."
    },
    "jet_rearm": {
      "title": "Штурмовик: боезапас и аэродром",
      "text": "У штурмовика 10 залпов (поле ammo). Пустой — он бросает цель, летит к ближайшему своему аэродрому и за 8 с (rearm_seconds) пополняет боезапас и чинит четверть корпуса. Без своего аэродрома ждёт, пока вы его захватите. Режим «Управляемые бомбы» (C) бьёт только по наземным целям (targets: ground)."
    }
  },
