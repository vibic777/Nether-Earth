; Engine configuration file.
; Godot 4.7. Contributor: vibic777

config_version=5

[application]

config/name="Nether Earth Reloaded"
config/description="Nether Earth Reloaded — оригинальная RTS по мотивам концепции Nether Earth (1987). Контрибьютор: vibic777"
config/version="0.6.1"
config/auto_accept_quit=false
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.04, 0.05, 0.06, 1)
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.09, 1)

[autoload]

Net="*res://scripts/net_hub.gd"
